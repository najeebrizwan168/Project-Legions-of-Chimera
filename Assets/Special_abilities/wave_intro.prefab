--- !u!114 &8602771973031331261
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7891974755593977286}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 45243299be175b546a675756d56e2a5d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  texts:
  - "Heroes who hesitate fall \u2014 upgrade now and rise above!\""
  - "Next wave: deadlier, faster, stronger\u2026 upgrade or fall!\""
  - "The next wave is stronger \u2014 upgrade now if you want to survive!"
  - "Your enemies grow fiercer\u2026 only upgrades can keep you ahead!"
  - "Wave cleared, but tougher foes march forward \u2014 spend EXP wisely"
  - The horde adapts each round; evolve your hero or be left behind!
  - "\"More enemies are coming \u2014 power up before it\u2019s too late!\""
  - "\"Victory won\u2019t come cheap\u2026 upgrade now and face the storm!\""
  - "\"They\u2019re sending their elites next \u2014 strengthen your hero to match
    them!\""
  - "You\u2019ve proven strong, but the next wave is merciless \u2014 upgrade fast!\""
  - "The battlefield shifts \u2014 spend coins to shift it in your favor!\""
  - "\"Next wave won\u2019t forgive mistakes \u2014 upgrade and strike back harder!"
  - '"Your strength is tested, your upgrades decide the outcome!"'
  - "\"Stronger enemies ahead \u2014 only stronger heroes will stand tall!\""
  - "\"The horde grows \u2014 your power must grow faster!\""
  - "\"Survival is earned with EXP \u2014 invest before the next clash!\""
  - "\"The next assault is brutal\u2026 upgrade to turn the tide!"
  - "They\u2019re coming in greater numbers \u2014 enhance your hero now!\""
  - Only the upgraded survive the waves ahead!"
  - "Coins make champions \u2014 use yours before the storm arrives!\""
  textDisplay: {fileID: 7199128178694333920}
  EXP: {fileID: 8859086426697310157}
  heroSprites:
